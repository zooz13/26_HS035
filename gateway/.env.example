GATEWAY_ID=gateway-laptop-001
DEVICE_ID=esp32-rx-001
LINK_ID=link-01

# Windows example: COM3
# Raspberry Pi/Linux example: /dev/ttyUSB0
SERIAL_PORT=COM3
SERIAL_BAUDRATE=921600
SERIAL_TIMEOUT_SEC=1
SERIAL_RECONNECT_SEC=5
SERIAL_MAX_LINE_BYTES=16384
SERIAL_ERROR_CAPTURE_BYTES=512

LOG_LEVEL=INFO

REALTIME_WINDOW_SEC=5
RAW_LOG_WINDOW_SEC=60

LOCAL_DATA_DIR=./data
LOCAL_RAWLOG_DIR=./data/rawlogs
LOCAL_SPOOL_DIR=./data/spool
LOCAL_FAILED_DIR=./data/failed
LOCAL_REALTIME_DRYRUN_DIR=./data/realtime_dryrun
LOCAL_REALTIME_SPOOL_DIR=./data/realtime_spool
LOCAL_PREPROCESSED_LOG_DIR=./data/preprocessed
LOCAL_SETUP_DIR=./data/setup
LOCAL_SETUP_SPOOL_DIR=./data/setup_spool

COMPRESSION=gzip
GZIP_COMPRESS_LEVEL=6
DELETE_UNCOMPRESSED_AFTER_COMPRESS=true
S3_UPLOAD_ENABLED=false
DELETE_LOCAL_AFTER_UPLOAD=false

AWS_REGION=us-west-2
# Placeholder only. Set the actual bucket name in .env.
S3_BUCKET=your-csi-bucket
S3_RAWLOG_PREFIX=rawlog/
S3_PREPROCESSED_PREFIX=preprocessed/

# Local placeholder. Set the actual HTTP(S) endpoint in .env only when
# REALTIME_SEND_ENABLED=true.
MODEL_SERVER_URL=http://127.0.0.1:8000
MODEL_SERVER_TIMEOUT_SEC=20
REALTIME_SEND_ENABLED=false
REALTIME_RETRY_SEC=10

BASELINE_STATE_JSON=./data/baseline/baseline_state.json
BASELINE_RELOAD_SEC=10
BASELINE_ID=baseline_room_101_v001
# Generated by baseline-collect; optional calibration-collect replaces it.
CALIBRATION_ID=
DEVICE_GROUP_ID=esp_group_101
ROOM_ID=room_101
ROOM_NAME=Room 101
SETUP_RELOAD_SEC=10
AMPLITUDE_NPY_ENABLED=false

# Staging only: sends real normalized motion_input with fixed Stage-1 scores.
TRANSPORT_TEST_ENABLED=false
TRANSPORT_TEST_STAGE1_SCORE=3.0

# Development-only dashboard control polling. The model server endpoint is
# unauthenticated in the current staging flow; do not expose it in production.
DASHBOARD_CONTROL_ENABLED=false
REMOTE_SETUP_POLL_SEC=2
BASELINE_COLLECTION_SEC=300

PREPROCESSED_LOG_ENABLED=true

DASHBOARD_STATUS_ENABLED=true
DASHBOARD_STATUS_PATH=./dashboard/status.json
DASHBOARD_UPDATE_SEC=1
# Required for the interactive TX firmware controls. Keep localhost unless an
# authenticated reverse proxy is added.
DASHBOARD_HTTP_ENABLED=false
DASHBOARD_HTTP_HOST=127.0.0.1
DASHBOARD_HTTP_PORT=8080
DASHBOARD_DIR=./dashboard

# S3 uploads use presigned PUT URLs issued by MODEL_SERVER_URL.
# Do not configure AWS credentials on the Gateway.
